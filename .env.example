# ==============================================================================
# SAP SuccessFactors Recruiting Resume Shifter - Environment Configuration
# ==============================================================================

# SuccessFactors OData API Base URL (e.g., https://api12preview.sapsf.eu/odata/v2 or https://api.successfactors.com/odata/v2)
SF_API_BASE_URL=https://api12preview.sapsf.eu/odata/v2

# SuccessFactors Company / Tenant ID
SF_COMPANY_ID=YOUR_COMPANY_ID

# ------------------------------------------------------------------------------
# Authentication Configuration
# Options: 'oauth2_saml' (Recommended Production), 'basic', or 'mock'
# ------------------------------------------------------------------------------
AUTH_TYPE=oauth2_saml

# --- OAuth 2.0 SAML Bearer Flow Settings ---
# Client ID / API Key registered in SF Admin Center -> Manage OAuth2 Client Applications
SF_CLIENT_ID=YOUR_OAUTH_CLIENT_API_KEY

# Integration Technical User ID with Recruiting OData Permissions
SF_USER_ID=sf_integration_user

# OAuth Token Endpoint (defaults to ${SF_API_BASE_URL}/../oauth/token)
SF_TOKEN_URL=https://api12preview.sapsf.eu/oauth/token

# Path to the X.509 RSA Private Key file (PEM format) or content
SF_PRIVATE_KEY_PATH=/path/to/private_key.pem
# SF_PRIVATE_KEY_CONTENT="-----BEGIN RSA PRIVATE KEY-----\n..."

# --- Basic Authentication Settings (Alternative for Dev/QA) ---
# SF_USERNAME=sf_admin
# SF_PASSWORD=YourPasswordHere

# ------------------------------------------------------------------------------
# Batch Engine & Resilience Settings
# ------------------------------------------------------------------------------
BATCH_TOP=1000
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
BACKOFF_FACTOR=1.0
RATE_LIMIT_PAUSE_SECONDS=0.05

# ------------------------------------------------------------------------------
# File Paths & Logging
# ------------------------------------------------------------------------------
WATERMARK_FILE_PATH=watermark.txt
LOGS_DIR=logs
SUMMARY_CSV_PATH=resume_snapshot_run_summary.csv
LOG_LEVEL=INFO
